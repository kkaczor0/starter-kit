{
  "_version": "1.65.0",
  "sap.app": {
    "id": "stk.starterkit3",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.16.1",
      "toolsId": "a3255d8a-ca2c-43aa-bd8e-a56bf3b5222e"
    },
    "dataSources": {
      "mainService": {
        "uri": "/V2/Northwind/Northwind.svc/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.131.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "stk.starterkit3.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "refreshAfterChange": false,
          "useBatch": false
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "stk.starterkit3.view",
        "async": true,
        "viewPath": "stk.starterkit3.view",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "CustomersList",
          "pattern": ":?query:",
          "target": [
            "CustomersList"
          ]
        },
        {
          "name": "CustomerDetails",
          "pattern": "CustomerDetails/{CustomerID}",
          "target": [
            "CustomerDetails"
          ]
        },
        {
          "name": "CreateCustomer",
          "pattern": "CreateCustomer",
          "target": [
            "CreateCustomer"
          ]
        },
        {
          "name": "EmployeeList",
          "pattern": "EmployeeList",
          "target": [
            "EmployeeList"
          ]
        }
      ],
      "targets": {
        "CustomersList": {
          "viewType": "XML",
          "viewName": "CustomersList"
        },
        "CustomerDetails": {
          "viewType": "XML",
          "viewName": "CustomerDetails"
        },
        "CreateCustomer": {
          "viewType": "XML",
          "viewName": "CreateCustomer"
        },
        "EmployeeList": {
          "viewType": "XML",
          "viewName": "EmployeeList"
        }
      }
    },
    "rootView": {
      "viewName": "stk.starterkit3.view.App",
      "type": "XML",
      "id": "App"
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "stkstarterkit3"
  }
}
